# MinerU Tianshu 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# ===== 服务器配置 =====
# 本地开发: http://localhost:8100
# 服务器部署: http://your-server-ip:8100 或 http://your-domain.com:8100
SERVER_BASE_URL=http://localhost:8100

# ===== Worker 配置 =====
# 每个设备的 Worker 数量 (默认: 2)
WORKERS_PER_DEVICE=2

# ===== 数据目录 =====
# 数据存储根目录 (默认: ~/mineru)
# DATA_DIR=~/mineru
