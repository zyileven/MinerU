FROM docker.m.daocloud.io/nvidia/cuda:12.6.0-runtime-ubuntu24.04

LABEL maintainer="MinerU Team"
LABEL description="MinerU Tianshu - Enterprise Document Parsing Service (GPU Mode)"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    MINERU_MODEL_SOURCE=local \
    APP_HOME=/app/mineru_tianshu

RUN sed -i 's@//.*archive.ubuntu.com@//mirrors.aliyun.com@g' /etc/apt/sources.list.d/ubuntu.sources && \
    sed -i 's@//.*security.ubuntu.com@//mirrors.aliyun.com@g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true && \
    rm -f /etc/apt/sources.list.d/cuda*.list 2>/dev/null || true

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        python3-pip \
        gcc \
        g++ \
        make \
        libxml2-dev \
        libxslt1-dev \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender-dev \
        libgomp1 \
        ffmpeg \
        fonts-noto-core \
        fonts-noto-cjk \
        fontconfig \
        curl \
        wget \
        git \
    && fc-cache -fv \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN sed -i.bak 's@//mirrors.aliyun.com@//archive.ubuntu.com@g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        libreoffice-writer \
        libreoffice-core && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    mv /etc/apt/sources.list.d/ubuntu.sources.bak /etc/apt/sources.list.d/ubuntu.sources

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1

RUN chmod 1777 /tmp

WORKDIR ${APP_HOME}

RUN python3 -m venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH"

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install "torch>=2.0.0" "transformers>=4.40.0" "numpy>=1.24.0,<2.0.0" "einops>=0.8.0" && \
    pip install "vllm>=0.10.1.1,<0.12" && \
    pip install "mineru[core]>=2.5.0" && \
    pip install "litserve>=0.2.0" "fastapi>=0.115.0" "uvicorn[standard]>=0.32.0" "aiohttp>=3.11.0" "loguru>=0.7.0" && \
    pip install "albumentations>=1.4.4,<2.0.0" "albucore>=0.0.13,<0.0.20" && \
    pip install "markdownify>=1.2.2" "markitdown[all]>=0.1.3" && \
    pip install "minio>=7.2.0" && \
    python -c "import vllm; import mineru; import litserve; import fastapi; import uvicorn; import aiohttp; import loguru; import albumentations; import markitdown; import minio; print('✅ All packages installed successfully')"

RUN echo '{"config_version": "1.3.1", "models-dir": {"pipeline": "", "vlm": ""}}' > /root/mineru.json

RUN MINERU_MODEL_SOURCE=modelscope mineru-models-download -s modelscope -m all && \
    echo "✅ Models downloaded successfully"

RUN mkdir -p /data/db /data/output && \
    chmod -R 755 /data

COPY task_db.py api_server.py litserve_worker.py task_scheduler.py start_all.py client_example.py ./

# 暴露端口
# API Server: 8100
# Worker Server: 9100
EXPOSE 8100 9100

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8100/docs', timeout=5)" || exit 1

# 启动脚本 (GPU 模式)
CMD ["python", "start_all.py", \
     "--accelerator", "cuda", \
     "--api-port", "8100", \
     "--worker-port", "9100", \
     "--output-dir", "/data/output", \
     "--workers-per-device", "1"]
